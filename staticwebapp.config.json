{
  "routes": [
    {
      "route": "api/drop.js",
      "methods": [
        "get",
        "post",
        "head",
        "options"
      ],
      "rewrite": "/drop",
      "statusCode": 200,
      "allowedRoles": [
        "owner"
      ],
      "headers": {
        "X-DEAD_DROP": "true"
      }
    },
    {
      "route": "/api/drop",
      "methods": [
        "get",
        "head",
        "post",
        "options"
      ],
      "statusCode": 300,
      "allowedRoles": [
        "owner"
      ],
      "headers": {
        "X-Dead-drop=true": "OMEGA_"
      }
    }
  ]
}